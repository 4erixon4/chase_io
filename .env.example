# =============================================================================
# chase_io — SINGLE source of truth for all configuration + secrets.
#
#   Local / VPS host : copy this file to  .env  and fill in real values.
#   Coolify deploy   : paste these same KEY=VALUE pairs into the stack's
#                      "Environment Variables" in the Coolify UI.
#
# .env is gitignored and MUST NEVER be committed. The Python setup scripts read
# these from the environment (they auto-load .env via scripts/lib_env.py), and
# docker-compose reads the "deploy" vars below for ${...} interpolation.
# =============================================================================

# ---- Deploy / compose (read by docker-compose.yml) --------------------------
# PUID/PGID — the ONE place these are defined. They MUST equal the Storage Box
# CIFS mount in /etc/fstab (uid=1000,gid=1000). Change both together and remount,
# or the containers can't write to /mnt/box.
PUID=1000
PGID=1000
TZ=Asia/Jerusalem

# Tailscale IP of the VPS (output of `tailscale ip -4`). Every published port in
# the production stack binds to THIS address only, never 0.0.0.0. (Not used by
# the local dev compose, which binds 127.0.0.1.)
TS_IP=100.x.y.z

# Plex claim token from https://www.plex.tv/claim — EXPIRES 4 MINUTES after you
# generate it. Only needed the first time a fresh Plex server is claimed; leave
# blank once claimed.
PLEX_CLAIM=

# ---- Secrets consumed by the setup scripts (NOT by docker-compose) ----------
# Arr / Prowlarr / Bazarr / Overseerr API keys are AUTO-DISCOVERED from the
# containers, so they are deliberately NOT here.

# TorBox API token — paid tier only (the free tier has no API). Used to drive
# Decypharr and by the TorBox reaper.
TORBOX_API_KEY=

# Decypharr Web UI login — you set these in Decypharr's first-run wizard.
DECYPHARR_USER=
DECYPHARR_PASS=

# Cleanuparr admin account — setup_cleanuparr.py CREATES this account on first
# run. Pick any username + a strong password.
CLEANUPARR_USER=
CLEANUPARR_PASS=

# OpenSubtitles.com account (free) — Bazarr subtitle provider.
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=

# ---- Optional -------------------------------------------------------------
# TorBox reaper dry-run. run_reaper.py forces DRY_RUN=true itself; the systemd
# timer on the VPS is what flips it live. Uncomment to force here.
# DRY_RUN=true
